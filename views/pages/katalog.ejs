<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card">
    <h1>Katalog Produk</h1>
    <p>Selamat datang di halaman katalog produk praktikum Express MVC.</p>
    <ul>
        <li>Produk A - Framework Express.js</li>
        <li>Produk B - Template Engine EJS</li>
        <li>Produk C - Arsitektur MVC Terisolasi</li>
    </ul>
</div>

<!-- Tambahkan Form POST di sini -->
<div class="card" style="margin-top: 2rem;">
    <h2>Form Tambah Produk</h2>
    <!-- Formulir mengirim data melalui metode HTTP POST -->
    <form action="/katalog/tambah" method="POST">
        <div style="margin-bottom: 1rem;">
            <label for="namaProduk">Nama Produk:</label><br>
            <!-- Atribut 'name' adalah kunci penting untuk dibaca di Back-End -->
            <input type="text" id="namaProduk" name="namaProduk" required>
        </div>
        <button type="submit">Kirim Payload</button>
    </form>
</div>

